/* pages/messages/messages.wxss */
.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6fa;
}

/* 头部 */
.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.msg-title-wrap {
  display: flex;
  flex-direction: column;
}
.msg-main-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}
.msg-sub-title {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}
.msg-readall {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--primary);
  background: rgba(74, 144, 226, .12);
  border-radius: 32rpx;
  font-weight: 600;
}
.msg-readall-disabled {
  color: #bbb;
  background: #f2f4f8;
}

/* 消息列表 */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.msg-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .04);
  position: relative;
  overflow: hidden;
}
.msg-card-hover {
  opacity: .95;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, .06);
}
.msg-card-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  position: relative;
}
.msg-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, .12);
}
.msg-avatar-icon {
  font-size: 44rpx;
}
.msg-unread-strip {
  position: absolute;
  left: -24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: #ff4d4f;
  border-radius: 0 4rpx 4rpx 0;
}
.msg-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}
.msg-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.msg-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}
.msg-card-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
}
.msg-card-content {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.msg-card-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.msg-card-text {
  font-size: 26rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.msg-card-text-unread {
  color: #333;
  font-weight: 500;
}
.msg-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #bbb;
}
.msg-card-contact {
  color: var(--primary);
  background: rgba(74, 144, 226, .08);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

/* 未登录 */
.guest-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  text-align: center;
}
.guest-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.guest-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 40rpx;
}
.guest-btn {
  min-width: 260rpx;
  padding: 18rpx 56rpx;
  font-size: 30rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 44rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, .35);
}
.guest-btn-hover {
  opacity: .9;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx;
  text-align: center;
}
.empty-icon-wrap {
  margin-bottom: 24rpx;
}
.empty-icon-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 226, .08);
}
.empty-emoji {
  font-size: 80rpx;
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.empty-tip {
  font-size: 24rpx;
  color: #999;
  padding: 0 40rpx;
}

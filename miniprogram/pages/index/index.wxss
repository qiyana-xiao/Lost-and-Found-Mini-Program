/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f5f6fa;
  padding: 16rpx 24rpx 8rpx;
}

.search-bar {
  margin-bottom: 16rpx;
}
.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .06);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-ph {
  color: #bbb;
  font-size: 26rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
}
.tab-active {
  color: #fff;
  background: var(--primary);
  font-weight: 600;
}

.cats {
  white-space: nowrap;
}
.cats-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}
.cat {
  display: inline-block;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #666;
  background: #fff;
  border-radius: 30rpx;
}
.cat-active {
  color: var(--primary);
  background: rgba(74, 144, 226, .12);
  font-weight: 600;
}

.list {
  padding: 16rpx 24rpx 0;
}
.item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.item-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f2f4f8;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
}
.item-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 12rpx;
}
.item-tags {
  margin: 10rpx 0;
}
.item-tags .cat-chip {
  margin-left: 12rpx;
}
.item-meta {
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #aaa;
  display: flex;
  gap: 24rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 60rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, .45);
  z-index: 20;
}

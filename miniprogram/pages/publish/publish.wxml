<!-- pages/publish/publish.wxml -->
<view class="page">
  <view class="card form">
    <view class="field">
      <text class="label">类型</text>
      <view class="type-group">
        <view class="type-opt {{type === 'lost' ? 'type-opt-active' : ''}}" data-type="lost" bindtap="onTypeChange">我丢失了</view>
        <view class="type-opt {{type === 'found' ? 'type-opt-active' : ''}}" data-type="found" bindtap="onTypeChange">我捡到了</view>
      </view>
    </view>

    <view class="field">
      <text class="label">标题<text class="req">*</text></text>
      <input class="input" placeholder="如：黑色华为耳机" value="{{title}}" bindinput="onTitleInput" maxlength="30" />
    </view>

    <view class="field">
      <text class="label">分类<text class="req">*</text></text>
      <picker class="picker" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-text {{categoryIndex < 0 ? 'placeholder' : ''}}">
          {{categoryIndex < 0 ? '请选择分类' : categories[categoryIndex]}}
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="label">地点<text class="req">*</text></text>
      <input class="input" placeholder="如：图书馆三楼" value="{{location}}" bindinput="onLocationInput" />
    </view>

    <view class="field">
      <text class="label">时间</text>
      <picker class="picker" mode="date" value="{{happenTime}}" bindchange="onDateChange">
        <view class="picker-text">{{happenTime}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">描述</text>
      <textarea class="textarea" placeholder="补充物品特征、细节等（选填）" value="{{description}}" bindinput="onDescInput" maxlength="200" />
    </view>

    <view class="field">
      <text class="label">图片<text class="req">*</text><text class="count">（已选 {{images.length}}/3）</text></text>
      <view class="imgs">
        <view class="img-item" wx:for="{{images}}" wx:key="*this">
          <image class="img-thumb" src="{{item}}" mode="aspectFill" />
          <view class="img-del" data-index="{{index}}" bindtap="onRemoveImage">×</view>
        </view>
        <view wx:if="{{images.length < 3}}" class="img-add" bindtap="onChooseImage">＋</view>
      </view>
    </view>

    <view class="field">
      <text class="label">联系方式<text class="req">*</text></text>
      <input class="input" placeholder="微信或手机号" value="{{contact}}" bindinput="onContactInput" maxlength="20" />
    </view>
  </view>

  <button class="btn-primary submit safe-bottom" loading="{{submitting}}" bindtap="onSubmit">
    {{isEdit ? '保存修改' : '发布'}}
  </button>
</view>

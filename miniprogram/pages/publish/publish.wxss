/* pages/publish/publish.wxss */
.page {
  padding: 24rpx;
  min-height: 100vh;
}
.form {
  padding: 8rpx 28rpx;
}
.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child {
  border-bottom: none;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.req {
  color: #FF7875;
  margin-left: 4rpx;
}
.count {
  color: #999;
  margin-left: 8rpx;
  font-size: 24rpx;
}

.type-group {
  display: flex;
  gap: 20rpx;
}
.type-opt {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f3f5f9;
  color: #666;
  font-size: 28rpx;
}
.type-opt-active {
  background: rgba(74, 144, 226, .12);
  color: var(--primary);
  font-weight: 600;
  border: 1rpx solid var(--primary);
}

.input {
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
}
.picker-text {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #333;
}
.picker-text.placeholder {
  color: #bbb;
}
.textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 0;
}

.imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 30rpx;
  border-bottom-left-radius: 12rpx;
}
.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #cfd6e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #cfd6e0;
  background: #fafbfc;
}

.submit {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
}

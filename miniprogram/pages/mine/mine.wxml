<!--pages/mine/mine.wxml-->
<view class="page">
  <!-- 个人中心头部（渐变背景 + 装饰圆） -->
  <view class="profile">
    <view class="deco deco-1"></view>
    <view class="deco deco-2"></view>
    <view class="deco deco-3"></view>
    <view class="avatar-wrap" bindtap="onEditAvatar">
      <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="avatar">{{avatarText}}</view>
      <view class="avatar-cam">📷</view>
    </view>
    <view class="pinfo">
      <view class="nick" bindtap="onEditNick">
        <text class="nick-text">{{nickname}}</text>
        <text class="edit-ic">✎</text>
      </view>
      <view class="uid-chip">ID: {{shortUid}}</view>
    </view>
  </view>

  <view class="content">
    <!-- 已登录：统计、消息、操作、我的发布 -->
    <block wx:if="{{!isGuest}}">
      <!-- 统计（点击筛选下方列表） -->
      <view class="stats">
        <view class="stat {{filter === 'all' ? 'stat-active' : ''}}" data-key="all" bindtap="onStatTap">
          <view class="num">{{stats.total}}</view>
          <view class="lbl">发布</view>
        </view>
        <view class="stat {{filter === 'closed' ? 'stat-active' : ''}}" data-key="closed" bindtap="onStatTap">
          <view class="num">{{stats.closed}}</view>
          <view class="lbl">已认领</view>
        </view>
        <view class="stat {{filter === 'lost' ? 'stat-active' : ''}}" data-key="lost" bindtap="onStatTap">
          <view class="num num-lost">{{stats.lost}}</view>
          <view class="lbl">失物</view>
        </view>
        <view class="stat {{filter === 'found' ? 'stat-active' : ''}}" data-key="found" bindtap="onStatTap">
          <view class="num num-found">{{stats.found}}</view>
          <view class="lbl">招领</view>
        </view>
      </view>

      <!-- 留言消息提醒：有其他用户在你的条目下留言时显示 -->
      <view class="msg-bell" wx:if="{{unreadTotal > 0}}">
        <view class="bell-head">
          <view class="bell-title-wrap">
            <view class="bell-ic">🔔</view>
            <text class="bell-title">消息提醒</text>
          </view>
          <text class="bell-count">{{unreadTotal}} 条新留言</text>
        </view>
        <view
          class="bell-item"
          wx:for="{{unreadList}}"
          wx:key="itemId"
          data-id="{{item.itemId}}"
          bindtap="onUnreadTap"
          hover-class="bell-item-hover"
        >
          <view class="bell-dot"></view>
          <view class="bell-body">
            <view class="bell-item-title">{{item.title}}</view>
            <view class="bell-item-msg">{{item.latestContent}}</view>
          </view>
          <view class="bell-right">
            <text class="bell-badge">{{item.count}}</text>
            <text class="bell-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>

      <!-- 账号操作 -->
      <view class="op-row">
        <view class="op-btn" hover-class="op-btn-hover" bindtap="onEditNick">
          <text class="op-ic">✏️</text>修改昵称
        </view>
        <view class="op-btn" hover-class="op-btn-hover" bindtap="onEditAvatar">
          <text class="op-ic">📷</text>修改头像
        </view>
        <view class="op-btn op-danger" hover-class="op-btn-hover" bindtap="onLogout">
          <text class="op-ic">🚪</text>退出登录
        </view>
      </view>

      <!-- 我的发布 -->
      <view class="sec-title">
        <view class="sec-bar"></view>
        <text class="sec-text">{{filterLabel}}</text>
      </view>

      <block wx:if="{{list.length > 0}}">
        <view class="mi-item" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCardTap" hover-class="mi-item-hover">
          <view class="mi-main">
            <view class="mi-cover">
              <image wx:if="{{item.cover}}" class="mi-img" src="{{item.cover}}" mode="aspectFill" data-index="{{index}}" binderror="onCoverError" />
              <view wx:else class="mi-ph">{{item.emoji}}</view>
            </view>
            <view class="mi-body">
              <view class="mi-title">{{item.title}}</view>
              <view class="mi-tags">
                <text class="badge {{item.statusClass}}">{{item.statusLabel}}</text>
                <text class="mi-type mi-{{item.type}}">{{item.typeLabel}}</text>
              </view>
              <view class="mi-meta">{{item.category}} · {{item.createdAtText}}</view>
            </view>
          </view>
          <view class="mi-actions">
            <view wx:if="{{item.status === 'open'}}" class="mi-btn mi-ok" data-id="{{item._id}}" catchtap="onMarkClosed">标记认领</view>
            <view class="mi-btn" data-id="{{item._id}}" catchtap="onEdit">编辑</view>
            <view class="mi-btn mi-del" data-id="{{item._id}}" catchtap="onDelete">删除</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="empty-emoji">📭</view>
        <view class="empty-text">{{emptyText}}</view>
        <view class="empty-btn" hover-class="empty-btn-hover" bindtap="onGoPublish">去发布</view>
      </view>
    </block>

    <!-- 未登录：仅提示登录 -->
    <block wx:else>
      <view class="guest-card">
        <view class="lock-emoji">🔒</view>
        <view class="guest-text">登录后即可查看我的发布</view>
        <view class="guest-btn" hover-class="guest-btn-hover" bindtap="onGoLogin">登录 / 注册</view>
      </view>
    </block>
  </view>
</view>

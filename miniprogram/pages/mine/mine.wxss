/* pages/mine/mine.wxss */
.page {
  padding: 24rpx;
  min-height: 100vh;
}

/* 个人中心头部 */
.profile {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #4a90e2, #5aa0ef);
  border-radius: 20rpx;
  color: #fff;
}
/* 头像（可点击更换） */
.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.avatar-cam {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  color: #4a90e2;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .12);
}
.pinfo {
  margin-left: 24rpx;
  min-width: 0;
}
.nick {
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.edit-ic {
  font-size: 24rpx;
  margin-left: 12rpx;
  opacity: .85;
}
.uid {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: .8;
}

/* 身份标识 */
.role-row {
  margin-top: 10rpx;
}
.role-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.role-guest {
  background: rgba(255, 255, 255, .22);
  color: #fff;
}
.role-user {
  background: #fff;
  color: #4a90e2;
  font-weight: 600;
}

/* 未登录提示 */
.guest-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
.lock-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.guest-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 32rpx;
}
.guest-btn {
  min-width: 240rpx;
  padding: 18rpx 48rpx;
  font-size: 30rpx;
  color: #fff;
  background: #4a90e2;
  border-radius: 40rpx;
  font-weight: 600;
}
.guest-btn-hover {
  opacity: .85;
}

/* 留言消息提醒 */
.msg-bell {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(74, 144, 226, .35);
}
.bell-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.bell-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.bell-count {
  font-size: 22rpx;
  color: var(--primary);
}
.bell-item {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-top: 1rpx solid #f2f4f8;
}
.bell-item-hover {
  background: #f7faff;
}
.bell-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  flex-shrink: 0;
}
.bell-body {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}
.bell-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bell-item-msg {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bell-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}
.bell-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.bell-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #bbb;
}

/* 统计 */
.stats {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}
.stat {
  flex: 1;
  text-align: center;
  position: relative;
}
.stat::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1px;
  background: #eee;
}
.stat:last-child::after {
  display: none;
}
.num {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
}
.stat .lost {
  color: #ff9f43;
}
.stat .found {
  color: #4a90e2;
}
.lbl {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 统计卡激活态（点击筛选） */
.stat-active .lbl {
  color: #4a90e2;
  font-weight: 600;
}
.stat-active::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -16rpx;
  width: 32rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #4a90e2;
  transform: translateX(-50%);
}

/* 账号操作行 */
.op-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.op-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #444;
  padding: 18rpx 0;
  border-radius: 36rpx;
  background: #f3f5f9;
}
.op-primary {
  color: #fff;
  background: var(--primary);
  font-weight: 600;
}
.op-danger {
  color: #FF7875;
  background: rgba(255, 120, 117, .10);
}
.op-sep {
  width: 24rpx;
  flex-shrink: 0;
}

/* 我的发布列表 */
.mitem {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.mi-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f2f4f8;
}
.mi-img {
  width: 100%;
  height: 100%;
}
.mi-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
}
.mi-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.mi-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mi-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 12rpx;
}
.mi-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}
.mi-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 16rpx;
}
.mi-btn {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(74, 144, 226, .10);
  border-radius: 28rpx;
  text-align: center;
}
.mi-del {
  color: #FF7875;
  background: rgba(255, 120, 117, .10);
}
.mi-ok {
  color: #52c41a;
  background: rgba(82, 196, 26, .10);
}



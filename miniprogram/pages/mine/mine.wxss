/* pages/mine/mine.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
}

/* ===== 渐变头部（通栏、底部大圆角） ===== */
.profile {
  position: relative;
  display: flex;
  align-items: center;
  padding: 44rpx 40rpx 120rpx;
  background: linear-gradient(135deg, #3f8ef7 0%, #4a90e2 45%, #6fb3f5 100%);
  border-radius: 0 0 56rpx 56rpx;
  color: #fff;
  overflow: hidden;
}
/* 头部装饰圆 */
.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, .08);
  /* 纯装饰：不参与点击命中，避免拦截下方卡片的 tap */
  pointer-events: none;
}
.deco-1 {
  width: 320rpx;
  height: 320rpx;
  top: -140rpx;
  right: -90rpx;
}
.deco-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: 30rpx;
  left: -100rpx;
  background: rgba(255, 255, 255, .06);
}
.deco-3 {
  width: 90rpx;
  height: 90rpx;
  top: 60rpx;
  right: 220rpx;
  background: rgba(255, 255, 255, .10);
}

/* 头像（可点击更换） */
.avatar-wrap {
  position: relative;
  z-index: 1;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
}
.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .22);
  border: 4rpx solid rgba(255, 255, 255, .4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.avatar-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, .65);
  background: #fff;
}
.avatar-cam {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #fff;
  color: #4a90e2;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .18);
  border: 2rpx solid rgba(255, 255, 255, .9);
}
.pinfo {
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}
.nick {
  display: flex;
  align-items: center;
  min-width: 0;
}
.nick-text {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.edit-ic {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, .2);
}
.uid-chip {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 22rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, .92);
  background: rgba(255, 255, 255, .16);
  border-radius: 26rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 内容区（卡片上浮，叠在头部上） =====
   position:relative + z-index:1 形成层叠上下文，
   保证静态卡片整体绘制在绝对定位装饰圆之上，点击不被拦截 */
.content {
  position: relative;
  z-index: 1;
  margin-top: -76rpx;
  padding: 0 24rpx 48rpx;
}

/* ===== 统计卡 ===== */
.stats {
  display: flex;
  background: #fff;
  border-radius: 28rpx;
  padding: 34rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(63, 142, 247, .16);
}
.stat {
  flex: 1;
  text-align: center;
  position: relative;
}
.stat::after {
  content: '';
  position: absolute;
  right: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 1rpx;
  background: #eef1f6;
}
.stat:last-child::after {
  display: none;
}
.num {
  font-size: 46rpx;
  font-weight: 700;
  color: #2b3445;
  line-height: 1.1;
}
.num-lost {
  color: #ff9f43;
}
.num-found {
  color: #36cfc9;
}
.lbl {
  display: inline-block;
  margin-top: 14rpx;
  padding: 5rpx 20rpx;
  font-size: 22rpx;
  color: #9aa3b2;
  border-radius: 24rpx;
}
.stat-active .num {
  color: var(--primary);
}
.stat-active .lbl {
  color: #fff;
  background: linear-gradient(135deg, #4a90e2, #6fb3f5);
  font-weight: 600;
}

/* ===== 留言消息提醒（暖色卡片） ===== */
.msg-bell {
  background: linear-gradient(135deg, #fff8ec 0%, #ffeed2 100%);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(245, 166, 35, .16);
}
.bell-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bell-title-wrap {
  display: flex;
  align-items: center;
}
.bell-ic {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 14rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(245, 166, 35, .25);
}
.bell-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #b8621b;
}
.bell-count {
  font-size: 20rpx;
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff9a3d, #ff7a45);
}
.bell-item {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: rgba(255, 255, 255, .78);
  border-radius: 18rpx;
}
.bell-item-hover {
  background: #fff;
}
.bell-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  flex-shrink: 0;
  box-shadow: 0 0 0 6rpx rgba(255, 77, 79, .15);
}
.bell-body {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}
.bell-item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bell-item-msg {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a08a6d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bell-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}
.bell-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.bell-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #c3a276;
}

/* ===== 账号操作 ===== */
.op-row {
  display: flex;
  background: #fff;
  border-radius: 28rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 45, 61, .06);
}
.op-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #4a5568;
  padding: 22rpx 0;
  border-radius: 18rpx;
  background: #f4f6fa;
}
.op-btn + .op-btn {
  margin-left: 20rpx;
}
.op-btn-hover {
  background: #e9eef7;
}
.op-ic {
  margin-right: 10rpx;
  font-size: 26rpx;
}
.op-danger {
  color: #ff7875;
  background: rgba(255, 120, 117, .1);
}
.op-danger.op-btn-hover {
  background: rgba(255, 120, 117, .18);
}

/* ===== 区块标题 ===== */
.sec-title {
  display: flex;
  align-items: center;
  margin: 4rpx 8rpx 20rpx;
}
.sec-bar {
  width: 10rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #4a90e2, #6fb3f5);
  margin-right: 16rpx;
}
.sec-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b3445;
}

/* ===== 我的发布列表 ===== */
.mi-item {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 45, 61, .06);
}
.mi-item-hover {
  background: #f8fbff;
}
.mi-main {
  display: flex;
  align-items: stretch;
}
.mi-cover {
  width: 152rpx;
  height: 152rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f2f4f8;
}
.mi-img {
  width: 100%;
  height: 100%;
}
.mi-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
}
.mi-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}
.mi-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3445;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mi-tags {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.mi-type {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.mi-lost {
  color: #ff7875;
  background: rgba(255, 120, 117, .1);
}
.mi-found {
  color: #0fb5b0;
  background: rgba(54, 207, 201, .14);
}
.mi-meta {
  margin-top: auto;
  padding-top: 14rpx;
  font-size: 22rpx;
  color: #9aa3b2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mi-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f4f8;
}
.mi-btn {
  padding: 10rpx 28rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(74, 144, 226, .09);
  border-radius: 30rpx;
  text-align: center;
}
.mi-ok {
  color: #52c41a;
  background: rgba(82, 196, 26, .1);
}
.mi-del {
  color: #ff7875;
  background: rgba(255, 120, 117, .1);
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 110rpx 0;
  color: var(--sub);
}
.empty-emoji {
  font-size: 110rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #9aa3b2;
}
.empty-btn {
  margin-top: 36rpx;
  padding: 18rpx 64rpx;
  background: linear-gradient(135deg, #4a90e2, #6fb3f5);
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(74, 144, 226, .35);
}
.empty-btn-hover {
  opacity: .85;
}

/* ===== 未登录提示 ===== */
.guest-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 90rpx 40rpx;
  background: #fff;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(31, 45, 61, .06);
}
.lock-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.guest-text {
  font-size: 28rpx;
  color: #9aa3b2;
  margin-bottom: 40rpx;
}
.guest-btn {
  min-width: 260rpx;
  padding: 20rpx 56rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a90e2, #6fb3f5);
  border-radius: 44rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(74, 144, 226, .35);
}
.guest-btn-hover {
  opacity: .85;
}

/* pages/detail/detail.wxss */
.page {
  padding: 24rpx;
}
.swiper {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef2f8;
}
.slide {
  width: 100%;
  height: 100%;
}
.slide-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  background: #eef2f8;
  color: #b8c2d0;
}
.swiper-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
}

.info {
  margin-top: 24rpx;
  padding: 28rpx;
}
.info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.info-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  flex: 1;
  margin-right: 16rpx;
}
.info-tags {
  margin: 16rpx 0;
}
.info-tags .cat-chip {
  margin-left: 12rpx;
}
.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
  margin-top: 14rpx;
}
.row-label {
  color: #999;
  width: 96rpx;
  flex-shrink: 0;
}
.row-val {
  flex: 1;
  color: #444;
}
.info-desc {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  font-size: 27rpx;
  color: #555;
  line-height: 1.6;
}

.contact {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
}
.contact-val {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}
.copy-hint {
  font-size: 22rpx;
  color: #bbb;
}

.msgs {
  margin-top: 24rpx;
  padding: 28rpx;
}
.msgs-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.msgs-empty {
  color: #bbb;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.msg {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}
.msg-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
.msg-foot {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #aaa;
}
.msg-contact {
  color: var(--primary);
}

.bottom-gap {
  height: 180rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, .06);
}
.msg-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
}
.close-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
}
.closed-tip {
  width: 100%;
  text-align: center;
  color: var(--closed);
  font-size: 28rpx;
  padding: 22rpx 0;
}

/* 留言弹窗 */
.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .45);
}
.modal-content {
  position: relative;
  width: 86%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 101;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-input {
  height: 84rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.modal-textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.modal-actions {
  display: flex;
  margin-top: 28rpx;
  gap: 20rpx;
}
.modal-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f2f3f5;
  color: #666;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.modal-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--primary);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

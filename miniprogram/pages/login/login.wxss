/* pages/login/login.wxss */
.page {
  padding: 32rpx 24rpx;
  min-height: 100vh;
}

.login-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .06);
}

.auth-tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.auth-tab {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  background: #f2f3f5;
  margin-right: 20rpx;
}

.auth-tab-active {
  color: #fff;
  background: #4A90E2;
  font-weight: 600;
}

.auth-input {
  height: 88rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.auth-ph {
  color: #bbb;
}

.auth-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #4A90E2;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 12rpx;
}
.auth-btn-hover {
  opacity: .88;
}
.auth-btn-disabled {
  opacity: .6;
}

.auth-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}

.login-hint {
  margin-top: 80rpx;
  text-align: center;
}

.hint-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #999;
}

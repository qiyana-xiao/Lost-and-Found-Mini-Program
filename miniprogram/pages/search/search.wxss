/* pages/search/search.wxss */
.page {
  min-height: 100vh;
}

/* ===== 渐变头部（通栏、底部大圆角，与导航栏蓝色衔接） ===== */
.search-head {
  position: relative;
  padding: 30rpx 32rpx 110rpx;
  background: linear-gradient(135deg, #3f8ef7 0%, #4a90e2 45%, #6fb3f5 100%);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}
.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, .08);
  /* 纯装饰：不参与点击命中，避免拦截下方卡片的 tap */
  pointer-events: none;
}
.deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -150rpx;
  right: -100rpx;
}
.deco-2 {
  width: 180rpx;
  height: 180rpx;
  bottom: 40rpx;
  left: -90rpx;
  background: rgba(255, 255, 255, .06);
}
.search-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 搜索输入框（白底胶囊 + 投影） */
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 45, 61, .14);
}
.input-icon {
  font-size: 26rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  background: transparent;
  padding: 0;
}
.input-ph {
  color: #b3b8c2;
}
.input-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  color: #fff;
  background: #c6cad2;
  border-radius: 50%;
  font-size: 28rpx;
  flex-shrink: 0;
}
.search-go {
  flex-shrink: 0;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: var(--primary);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(31, 45, 61, .14);
}

/* 类型快筛（渐变头部内的分段控件） */
.type-seg {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, .18);
  border-radius: 16rpx;
  padding: 8rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, .85);
  border-radius: 12rpx;
}
.seg-active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(31, 45, 61, .14);
}

/* ===== 内容区（上浮卡片需压在装饰圆之上） =====
   position:relative + z-index:1 形成层叠上下文，
   保证静态卡片整体绘制在绝对定位装饰圆之上，点击不被拦截 */
.content {
  position: relative;
  z-index: 1;
  margin-top: -76rpx;
  padding: 0 24rpx 48rpx;
}

/* ===== 分类二次筛选（仅结果含多分类时显示，单行横向滑动） ===== */
.cats {
  white-space: nowrap;
  padding: 4rpx 4rpx 18rpx;
  width: 100%;
}
.cats-inner {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 8rpx;
}
.cat {
  display: inline-block;
  padding: 14rpx 30rpx;
  font-size: 24rpx;
  color: #6b7484;
  background: #fff;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.cat-active {
  color: #fff;
  background: linear-gradient(135deg, #4a90e2, #6fb3f5);
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(74, 144, 226, .3);
}

.result-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 12rpx 24rpx;
  margin: 4rpx 4rpx 20rpx;
  font-size: 24rpx;
  color: #4a5568;
  background: rgba(255, 255, 255, .92);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 45, 61, .08);
}
.result-num {
  color: var(--primary);
  font-weight: 700;
  margin: 0 6rpx;
  font-size: 30rpx;
}
.result-kw {
  color: #6b7484;
  margin-left: 10rpx;
}

/* ===== 结果列表（白卡） ===== */
.list {
  padding: 0;
}
.item {
  display: flex;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 45, 61, .06);
}
.item-hover {
  background: #f8fbff;
}
.item-cover {
  width: 152rpx;
  height: 152rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f2f4f8;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
}
.item-body {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}
.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3445;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 12rpx;
}
/* 关键词高亮 */
.hl {
  color: #ff7a45;
  font-weight: 600;
}
.item-tags {
  margin: 12rpx 0;
}
.item-tags .cat-chip {
  margin-left: 12rpx;
}
.item-meta {
  font-size: 24rpx;
  color: #9aa3b2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0b7c3;
  display: flex;
  gap: 24rpx;
}

/* ===== 区块标题 ===== */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2b3445;
}
.sec-sub {
  font-size: 20rpx;
  color: #9aa3b2;
}
.sec-clear {
  font-size: 22rpx;
  color: #9aa3b2;
  padding: 10rpx 12rpx;
}

/* ===== 关键词 chips（小圆角，正式风） ===== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 14rpx 30rpx;
  background: #f4f6fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #4a5568;
}
.chip-hover {
  background: #e9eef7;
  color: var(--primary);
}
.chip-hot {
  display: inline-flex;
  align-items: center;
}
.hot-rank {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 20rpx;
  color: #fff;
  background: #c9d0dc;
  margin-right: 12rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.hot-rank-top {
  background: linear-gradient(135deg, #ff9a3d, #ff7a45);
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 90rpx 0;
  color: var(--sub);
}
.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #9aa3b2;
}

/* ===== 历史 / 热门 分区卡片 ===== */
.section {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 45, 61, .06);
}

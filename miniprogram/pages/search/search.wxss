/* pages/search/search.wxss */
.page {
  min-height: 100vh;
}
.search-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: #f3f5f9;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.search-go {
  flex-shrink: 0;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.cats {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
}
.cats-inner {
  display: inline-flex;
  gap: 16rpx;
}
.cat {
  display: inline-block;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #666;
  background: #f3f5f9;
  border-radius: 30rpx;
}
.cat-active {
  color: var(--primary);
  background: rgba(74, 144, 226, .12);
  font-weight: 600;
}

.list {
  padding: 16rpx 24rpx 0;
}
.item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.item-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f2f4f8;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: linear-gradient(135deg, #eaf2fc, #f7faff);
}
.item-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 12rpx;
}
.item-tags {
  margin: 10rpx 0;
}
.item-tags .cat-chip {
  margin-left: 12rpx;
}
.item-meta {
  font-size: 24rpx;
  color: #888;
}
.item-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #aaa;
  display: flex;
  gap: 24rpx;
}

/* 搜索框增强（带图标 + 可清除） */
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f3f5f9;
  border-radius: 36rpx;
  padding: 0 24rpx;
}
.input-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  background: transparent;
  padding: 0;
}
.input-ph {
  color: #b3b8c2;
}
.input-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  color: #fff;
  background: #c6cad2;
  border-radius: 50%;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 搜索历史 / 热门搜索 */
.section {
  padding: 28rpx 24rpx 0;
}
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.sec-clear {
  font-size: 22rpx;
  color: #999;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 10rpx 24rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #555;
}
.chip-hot {
  display: inline-flex;
  align-items: center;
}
.hot-rank {
  font-size: 20rpx;
  color: #a5abb8;
  margin-right: 10rpx;
  font-weight: 600;
}
.hot-top {
  color: #ff9f43;
}

/* 搜索结果 */
.result-bar {
  padding: 20rpx 24rpx 4rpx;
  font-size: 24rpx;
  color: #888;
}
.result-num {
  color: var(--primary);
  font-weight: 700;
  margin: 0 4rpx;
}
.result-kw {
  color: #666;
  margin-left: 8rpx;
}

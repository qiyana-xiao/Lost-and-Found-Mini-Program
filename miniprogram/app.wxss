/**app.wxss 全局样式与主题**/
page {
  --primary: #4A90E2;
  --accent: #F5A623;
  --open: #52C41A;
  --closed: #999999;
  --bg: #f5f6fa;
  --text: #333333;
  --sub: #999999;
  --line: #f0f0f0;
  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, input, textarea, scroll-view, image, button, swiper, swiper-item {
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  opacity: .55;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .08);
}

/* 标签 / 徽标 */
.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}
.tag-lost {
  background: #FF7875;
}
.tag-found {
  background: #36CFC9;
}
.cat-chip {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(74, 144, 226, .10);
}
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.badge-open {
  color: var(--open);
  background: rgba(82, 196, 26, .12);
}
.badge-closed {
  color: var(--closed);
  background: rgba(153, 153, 153, .12);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
  color: var(--sub);
}
.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
.empty-btn {
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.loading-more {
  text-align: center;
  color: var(--sub);
  font-size: 24rpx;
  padding: 30rpx 0;
}
